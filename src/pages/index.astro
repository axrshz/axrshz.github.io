---
import { Picture, getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import hero from '../assets/hero.jpg'

const socials = [
  ['X', 'https://x.com/axrshz'],
  ['GitHub', 'https://github.com/axrshz'],
  ['Email', 'mailto:axrshz@gmail.com'],
]

const widths = [480, 736]
const sizes = '(max-width: 640px) 100vw, 736px'
const quality = 80

// Preload the exact optimized files the <Picture> below renders,
// so the browser starts fetching the hero image with the HTML
// instead of waiting to discover the <img> in the body.
const preloadAvif = await getImage({ src: hero, widths, width: 736, height: 414, format: 'avif', quality })
const preloadWebp = await getImage({ src: hero, widths, width: 736, height: 414, format: 'webp', quality })
---

<BaseLayout title="Adarsh" description="">
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/avif" imagesrcset={preloadAvif.srcSet.attribute} imagesizes={sizes} fetchpriority="high" />
    <link rel="preload" as="image" type="image/webp" imagesrcset={preloadWebp.srcSet.attribute} imagesizes={sizes} fetchpriority="high" />
  </Fragment>
  <section>
    <Picture
      class="hero-image"
      src={hero}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      width={736}
      height={414}
      quality={quality}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <p class="lede">
      i'm interested in high-performance computing and distributed systems. lately, i have been diving deep into how models are trained and served at scale and learning about inference optimization, agents, post-training and evals.
    </p>
    <p class="lede">
      i also try to stay updated with latest AI progress and keep an end to end understanding from the research to infrastructure to application layer.
    </p>

    <ul class="socials">
      {socials.map(([label, href]) => (
        <li><a href={href} rel="me noopener">{label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  section {
    padding: 2rem 0 3rem;
  }
  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 736 / 414;
    background: var(--code-bg);
    margin-bottom: 1rem;
  }
  .eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.76rem;
    color: var(--muted);
    margin: 0 0 1.5rem;
    letter-spacing: 0.06em;
  }
  h1 {
    font-weight: 500;
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    letter-spacing: -0.04em;
    margin: 0 0 1.75rem;
    text-wrap: balance;
  }
  .lede {
    font-size: 1.3rem;
    line-height: 1.65;
    max-width: none;
    color: var(--ink);
    margin: 0 0 1.1rem;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .lede:last-of-type {
    margin-bottom: 0;
  }
  .lede a {
    color: var(--ink);
    border-bottom: 1px solid var(--muted);
  }
  .lede a:hover {
    border-bottom-color: var(--ink);
  }
  .socials {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }
  .socials li {
    display: inline-flex;
    align-items: center;
    margin: 0;
  }
  .socials li + li::before {
    content: '/';
    color: var(--hair);
    margin: 0 1rem;
  }
  .socials a {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--muted);
    border: none;
  }
  .socials a:hover {
    color: var(--ink);
  }
</style>
